{
  "kind": "collectionType",
  "collectionName": "news_feeds",
  "info": {
    "singularName": "news-feed",
    "pluralName": "news-feeds",
    "displayName": "NewsFeed"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "pin_post": {
      "type": "boolean"
    },
    "feed_title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "feed_title",
      "required": true
    },
    "like_count": {
      "type": "string",
      "required": true
    },
    "feed_description": {
      "type": "customField",
      "customField": "plugin::ckeditor.CKEditor",
      "options": {
        "output": "HTML",
        "preset": "rich",
        "licenseKey": "eyJhbGciOiJFUzI1NiJ9..OW8RY7iQlVQ2fPDRjOVl1Nw9xFK-c9NdR1W-ynYOWLPwEFfClTyTqUPVb_aYXJMTnZTbleid7KY3JVzR-v0BJA"
      }
    },
    "feed_description_down": {
      "type": "customField",
      "customField": "plugin::ckeditor.CKEditor",
      "options": {
        "output": "HTML",
        "licenseKey": "eyJhbGciOiJFUzI1NiJ9..OW8RY7iQlVQ2fPDRjOVl1Nw9xFK-c9NdR1W-ynYOWLPwEFfClTyTqUPVb_aYXJMTnZTbleid7KY3JVzR-v0BJA",
        "preset": "rich"
      }
    },
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "video_url": {
      "type": "string",
      "required": false
    },
    "gif_file": {
      "type": "string"
    },
    "seo": {
      "type": "component",
      "component": "shared.seo",
      "repeatable": false
    }
  }
}
