{
  "kind": "collectionType",
  "collectionName": "case_studies",
  "info": {
    "singularName": "case-study",
    "pluralName": "case-studies",
    "displayName": "Case Study"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "headline": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "headline",
      "required": true
    },
    "other_casestudy": {
      "type": "component",
      "component": "case-study.other-case-study",
      "repeatable": false
    },
    "eyebrow_headline": {
      "type": "string",
      "required": true
    },
   
    "state_1": {
      "type": "string",
      "required": true
    },
    "state_2": {
      "type": "string",
      "required": true
    },
    "state_3": {
      "type": "string",
      "required": true
    },
    "state_description1": {
      "type": "string",
      "required": true
    },
    "state_description2": {
      "type": "string",
      "required": true
    },
    "state_description3": {
      "type": "string",
      "required": true
    },
    "video_url": {
      "type": "string",
      "required": false
    },
    "main_image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "about_client": {
      "type": "text",
      "required": true
    },
    "location": {
      "type": "string",
      "required": true
    },
    "business_type": {
      "type": "string",
      "required": true
    },
    "service_rendered": {
      "type": "component",
      "component": "case-study.service-rendered",
      "repeatable": true
    },
     "case_body": {
      "type": "customField",
      "customField": "plugin::ckeditor.CKEditor",
      "options": {
        "output": "HTML",
        "preset": "rich",
        "licenseKey": "eyJhbGciOiJFUzI1NiJ9..OW8RY7iQlVQ2fPDRjOVl1Nw9xFK-c9NdR1W-ynYOWLPwEFfClTyTqUPVb_aYXJMTnZTbleid7KY3JVzR-v0BJA"
      }
    },
    "client_feedback": {
      "type": "component",
      "component": "case-study.client-feedback",
      "repeatable": false
    },
    "seo": {
      "type": "component",
      "component": "shared.seo",
      "repeatable": false
    }
   
  }
}
